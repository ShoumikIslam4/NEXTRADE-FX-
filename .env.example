# ==============================================================================
# NEXTRADE FX — Institutional Simulated Trading Platform Configuration
# ==============================================================================

# Server Environment & Port Configuration
NODE_ENV="development"
PORT=3000

# Super Administrator Seed Configuration
# Used ONLY on initial cold start to bootstrap the unique Super Admin account if it does not already exist.
ADMIN_EMAIL="info.soumik@gmail.com"
ADMIN_INITIAL_PASSWORD="CHANGE_TO_A_STRONG_UNIQUE_PASSWORD"

# Application Public Host URL (Injected automatically in Cloud Run)
APP_URL="http://localhost:3000"

# Gemini AI API Key (Injected automatically at runtime from user secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Cookie & Session Security Secret (Used for signing authentication cookies & JWT-style tokens)
AUTH_SECRET="CHANGE_TO_A_64_CHARACTER_RANDOM_HEX_SECRET"
SESSION_SECRET="CHANGE_TO_A_64_CHARACTER_RANDOM_HEX_SECRET"

# Gmail / SMTP Email Notification Configuration (Used for login/sign-in Gmail alerts)
# For Gmail: enable 2-Step Verification and generate an App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="YOUR_GMAIL_APP_PASSWORD"
SMTP_FROM="NEXTRADE FX <your-gmail-address@gmail.com>"
